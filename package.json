{
  "name": "gearswipe-com",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && npm run deploy:workers",
    "deploy:workers": "wrangler deploy && wrangler deploy -c wrangler.quote-api.toml",
    "deploy:hostgator": "npm run build && bash scripts/deploy-hostgator.sh",
    "logs": "wrangler tail",
    "logs:api": "wrangler tail -c wrangler.quote-api.toml"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.9.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
