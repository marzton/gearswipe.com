{
  "name": "gearswipe-com",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern .wrangler-dry-run",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && npm run deploy:workers",
    "deploy:workers": "wrangler deploy",
    "deploy:hostgator": "npm run build && bash scripts/deploy-hostgator.sh",
    "logs": "wrangler tail",
    "logs:api": "wrangler tail -c wrangler.quote-api.toml"
  },
  "dependencies": {
    "@sanity/client": "^8.6.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": ">=3.1.6",
    "fflate": ">=0.7.5"
  },
  "type": "module"
}
